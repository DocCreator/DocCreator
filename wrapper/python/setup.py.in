# All package metadata is declared in pyproject.toml.
# This file only exists to override Distribution so that the produced wheel
# is tagged as platform-specific (the .so shipped in package_data is not
# detected as an extension module by setuptools on its own).

from setuptools import setup
from setuptools.dist import Distribution


class BinaryDistribution(Distribution):
    def is_pure(self):
        return False

    def has_ext_modules(self):
        return True


setup(distclass=BinaryDistribution)
