{
    "id": "fr.labri.doccreator.doccreator",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.8",
    "sdk": "org.kde.Sdk",
    "command": "DocCreator",
    "finish-args": ["--share=ipc", "--socket=x11", "--socket=wayland", "--device=dri"],

    "modules": [
        {
            "name": "opencv",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": ["-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_INSTALL_LIBDIR=lib",
                            "-DBUILD_LIST=core,imgproc,imgcodecs,highgui,photo,geometry",
                            "-DENABLE_FAST_MATH=ON", "-DBUILD_DOCS=OFF", "-DBUILD_PERF_TESTS=OFF",
                            "-DBUILD_TESTS=OFF", "-DBUILD_EXAMPLES=OFF", "-DBUILD_opencv_apps=OFF",
                            "-DBUILD_JAVA=OFF", "-DBUILD_opencv_python3=OFF", "-DWITH_CUDA=OFF",
                            "-DWITH_FFMPEG=OFF", "-DWITH_GTK=OFF", "-DWITH_QT=OFF", "-DWITH_OPENCL=OFF",
                            "-DWITH_OPENEXR=OFF", "-DWITH_VTK=OFF", "-DWITH_EIGEN=OFF",
                            "-DWITH_PROTOBUF=OFF", "-DWITH_IPP=OFF", "-DWITH_ADE=OFF"],
            "sources": [
                { "type": "archive",
                  "url": "https://github.com/opencv/opencv/archive/refs/tags/5.0.0.tar.gz",
                  "sha256": "b0528f5a1d379d59d4701cb28c36e22214cc51cf64594e5b56f2d3e6c0233095" }
            ]
        },
        {
            "name": "leptonica",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": ["-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_INSTALL_LIBDIR=lib",
                            "-DBUILD_SHARED_LIBS=ON", "-DSW_BUILD=OFF", "-DBUILD_PROG=OFF"],
            "sources": [
                { "type": "archive",
                  "url": "https://github.com/DanBloomberg/leptonica/archive/refs/tags/1.87.0.tar.gz",
                  "sha256": "fa2b40c5caea96d1bb93a97486262aed8731b69ce25a84a6bf5d25323e33f631" }
            ]
        },
        {
            "name": "tesseract",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": ["-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_INSTALL_LIBDIR=lib",
                            "-DBUILD_SHARED_LIBS=ON", "-DSW_BUILD=OFF", "-DBUILD_TRAINING_TOOLS=OFF",
                            "-DDISABLE_CURL=ON", "-DDISABLE_ARCHIVE=ON", "-DOPENMP_BUILD=OFF"],
            "post-install": ["install -Dm644 eng.traineddata fra.traineddata -t ${FLATPAK_DEST}/share/tessdata"],
            "sources": [
                { "type": "archive",
                  "url": "https://github.com/tesseract-ocr/tesseract/archive/refs/tags/5.5.3.tar.gz",
                  "sha256": "9218e62793116d42a9f6d14cd9348518b27f382096eea3d0f2d1a24616bb5884" },
                { "type": "file",
                  "url": "https://github.com/tesseract-ocr/tessdata_best/raw/e12c65a915945e4c28e237a9b52bc4a8f39a0cec/eng.traineddata",
                  "sha256": "8280aed0782fe27257a68ea10fe7ef324ca0f8d85bd2fd145d1c2b560bcb66ba" },
                { "type": "file",
                  "url": "https://github.com/tesseract-ocr/tessdata_best/raw/e12c65a915945e4c28e237a9b52bc4a8f39a0cec/fra.traineddata",
                  "sha256": "907743d98915c91a3906dfbf6e48b97598346698fe53aaa797e1a064ffcac913" }
            ]
        },
        {
            "name": "doccreator",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": ["-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_INSTALL_LIBDIR=lib"],
            "sources": [
                { "type": "dir", "path": "../../..",
                  "skip": [".git", "build", "BUILD_PYTHON", "BUILD_PYTHON_OSMESA", "WHEELS", "WHEELS_OSMESA",
                           "bundlers/linux/flatpak/.flatpak-builder", "bundlers/linux/flatpak/doccreator_flatpak",
                           "bundlers/linux/flatpak/repo"] },
                { "type": "file",
                  "url": "https://gitlab.com/libeigen/eigen/-/archive/5.0.0/eigen-5.0.0.tar.gz",
                  "sha256": "315c881e19e17542a7d428c5aa37d113c89b9500d350c433797b730cd449c056",
                  "dest": "_flatpak_build/thirdparty",
                  "dest-filename": "eigen-5.0.0-eigen-5.0.0.tar.gz" }
            ]
        }
    ]
}
