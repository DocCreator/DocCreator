#!/bin/sh
#B: without -e, a failed step went unnoticed, and the continuous integration
# could pass without a dmg; -u catches a variable misspelt (DEST_DIR).
set -eu

APP_NAME=DocCreator
APP_VERSION=@DocCreatorVersion@
APP_ICON=@CMAKE_SOURCE_DIR@/software/DocCreator/adoc.icns
APP_LICENSE=@CMAKE_SOURCE_DIR@/software/DocCreator/license.txt
APP_INFO=@CMAKE_BINARY_DIR@/bundlers/mac/Info.plist
MAKE_DMG_SCRIPT=@CMAKE_SOURCE_DIR@/bundlers/mac/make_dmg.sh

INSTALL_PREFIX_DIR=@CMAKE_INSTALL_PREFIX@

DST_DIR=${1:-}
if [ "${DST_DIR}" = "" ] ; then
    DST_DIR=@CMAKE_INSTALL_PREFIX@/Bundle
fi

QT_BINARY_DIR=@QT_BIN_PATH@
if [ "${QT_BINARY_DIR}" = "" ]
then
    QT_BINARY_DIR=@_qt5Gui_install_prefix@/bin
fi

if [ ! -d ${INSTALL_PREFIX_DIR} ] ; then
    echo "ERROR: the specified installation prefix directory does not exist: ${INSTALL_PREFIX_DIR}"
    exit 1
fi

mkdir -p ${DST_DIR}
if [ ! -d ${DST_DIR} ] ; then
    echo "ERROR: the destination directory does not exist: ${DST_DIR}"
    exit 1
fi
rm -rf "${DST_DIR}/application" 2>/dev/null
rm -f "${DST_DIR}/${APP_NAME}-${APP_VERSION}.dmg" 2>/dev/null

mkdir -p "${DST_DIR}/application/DocCreator.app/Contents/MacOS"
mkdir -p "${DST_DIR}/application/DocCreator.app/Contents/Resources"
mkdir -p "${DST_DIR}/application/DocCreator.app/Contents/Frameworks" 
cp ${APP_ICON} "${DST_DIR}/application/DocCreator.app/Contents/Resources/DocCreator.icns" 

#the libraries installed with DocCreator, if any (macdeployqt adds the others)
for lib in "${INSTALL_PREFIX_DIR}"/lib/*.dylib "${INSTALL_PREFIX_DIR}"/lib/*.framework ; do
    [ -e "${lib}" ] || continue
    cp -R "${lib}" "${DST_DIR}/application/DocCreator.app/Contents/Frameworks/"
done

cp ${APP_LICENSE} "${DST_DIR}/application/"

#tessdata is installed when tesseract is built from sources
if [ -d "${INSTALL_PREFIX_DIR}/share/DocCreator/tessdata" ] ; then
    cp -r "${INSTALL_PREFIX_DIR}/share/DocCreator/tessdata" "${DST_DIR}/application/DocCreator.app/Contents/Resources/"
fi
cp -r ${INSTALL_PREFIX_DIR}/share/DocCreator/data "${DST_DIR}/application/DocCreator.app/Contents/Resources/"

cp ${INSTALL_PREFIX_DIR}/bin/DocCreator "${DST_DIR}/application/DocCreator.app/Contents/MacOS/"

cp ${APP_INFO} "${DST_DIR}/application/DocCreator.app/Contents/"


#macdeployqt copies the libraries the application depends on, Qt, OpenCV
#and theirs, wherever they are and whatever their install names
@QT_MACDEPLOYQT_EXECUTABLE@ "${DST_DIR}/application/DocCreator.app"

#macdeployqt only reports the libraries it cannot deploy, and the dmg of a
#broken application would still be made: check that the application
#depends only on the system and on itself (@rpath is Contents/Frameworks)
APP_CONTENTS="${DST_DIR}/application/DocCreator.app/Contents"
missingLibs=$(find "${APP_CONTENTS}" -type f \( -perm -u+x -o -name "*.dylib" \) -exec otool -L {} + 2>/dev/null \
    | grep -E '^[[:space:]]' | awk '{print $1}' | sort -u \
    | while read -r dep ; do
	case "${dep}" in
	    (/System/*|/usr/lib/*) ;;
	    (@rpath/*) [ -e "${APP_CONTENTS}/Frameworks/${dep#@rpath/}" ] || echo "${dep}" ;;
	    (@executable_path/*) [ -e "${APP_CONTENTS}/MacOS/${dep#@executable_path/}" ] || echo "${dep}" ;;
	    (@loader_path/*) ;;
	    (*) echo "${dep}" ;;
	esac
    done)
if [ -n "${missingLibs}" ] ; then
    echo "ERROR: the application depends on libraries that are not in it:"
    echo "${missingLibs}"
    exit 11
fi

mv "${DST_DIR}/application/DocCreator.app" "${DST_DIR}/application/${APP_NAME}-${APP_VERSION}.app"   #B ???

echo "${MAKE_DMG_SCRIPT} ${APP_NAME} ${APP_VERSION} ${DST_DIR}/application"

${MAKE_DMG_SCRIPT} ${APP_NAME} ${APP_VERSION} ${DST_DIR}/application

