# Write OUTPUT, an NSIS include for the uninstaller of DocCreator.nsi: a
# Delete for each file of PREFIX/programs and PREFIX/share, then a RMDir
# (not recursive) for each of their directories, the deepest first.
#
# DocCreator.nsi runs it when it is compiled, so that the files listed are
# those that its File /r commands pack: the uninstaller removes what was
# installed, and nothing else.
#
# cmake -DPREFIX=<install prefix> -DOUTPUT=<file> -P uninstall_list.cmake

cmake_minimum_required(VERSION 3.16)

foreach(var PREFIX OUTPUT)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "uninstall_list.cmake: ${var} is not defined")
  endif()
endforeach()

set(lines "; Generated by uninstall_list.cmake from ${PREFIX}: do not edit.\n")
set(dirs "")
foreach(top programs share)
  if(NOT IS_DIRECTORY "${PREFIX}/${top}")
    message(FATAL_ERROR "${PREFIX}/${top} does not exist: install DocCreator (cmake --install) before making the installer")
  endif()
  list(APPEND dirs "${top}")
  file(GLOB_RECURSE entries LIST_DIRECTORIES true RELATIVE "${PREFIX}" "${PREFIX}/${top}/*")
  foreach(entry IN LISTS entries)
    if(IS_DIRECTORY "${PREFIX}/${entry}")
      list(APPEND dirs "${entry}")
    else()
      string(REPLACE "/" "\\" path "${entry}")
      string(REPLACE "$" "$$" path "${path}") # $ starts a variable in NSIS
      string(APPEND lines "  Delete \"$INSTDIR\\${path}\"\n")
    endif()
  endforeach()
endforeach()

# a directory sorts before its content: reversed, the content comes first
list(SORT dirs)
list(REVERSE dirs)
foreach(dir IN LISTS dirs)
  string(REPLACE "/" "\\" path "${dir}")
  string(REPLACE "$" "$$" path "${path}")
  string(APPEND lines "  RMDir \"$INSTDIR\\${path}\"\n")
endforeach()

file(WRITE "${OUTPUT}" "${lines}")
