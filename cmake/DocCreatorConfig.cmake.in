# CMake package of DocCreator, installed by "make install".
#
#   find_package(DocCreator REQUIRED COMPONENTS Degradations)
#   target_link_libraries(myprog PRIVATE DocCreator::Degradations)
#
# DocCreator::Degradations is the degradation library: its headers are
# included as <Degradations/...hpp> (cf. Degradations/Degradations.hpp),
# it needs C++17, and it brings OpenCV with it.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenCV COMPONENTS @DOCCREATOR_OPENCV_COMPONENTS@)

include("${CMAKE_CURRENT_LIST_DIR}/DocCreatorTargets.cmake")

#the components this package provides
set(DocCreator_Degradations_FOUND TRUE)

check_required_components(DocCreator)
